{
  "name": "daonroad",
  "version": "1.0.0",
  "description": "DaOnRoad - 버스 노선 최적화 시스템",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win",
    "buildwin": "electron-builder --win",
    "buildmac": "electron-builder --mac",
    "vendor": "node scripts/vendor.js",
    "prestart": "npm run vendor",
    "predev": "npm run vendor",
    "prebuild": "npm run vendor",
    "prebuildwin": "npm run vendor",
    "prebuildmac": "npm run vendor",
    "test": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "jsdom": "26.1.0"
  },
  "build": {
    "appId": "com.daonroad.app",
    "productName": "DaOnRoad",
    "copyright": "Copyright © 2025 DaOnRoad",
    "directories": {
      "output": "../dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "index.html",
      "assets/**/*",
      "vendor/**/*"
    ],
    "extraResources": [
      {
        "from": "../docker-compose.yml",
        "to": "docker-compose.yml"
      },
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!venv/**",
          "!**/__pycache__/**",
          "!cache/**",
          "!*.pyc",
          "!.env",
          "!*.osm.pbf",
          "!*.xlsx",
          "!tests/**"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/DaOnRoad.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/DaOnRoad.ico"
    },
    "compression": "normal"
  },
  "author": "DaOnRoad",
  "dependencies": {
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3"
  }
}
